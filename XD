                                       mode='lines+markers', line=dict(color='#ffffff')))
        fig_trend.add_hline(y=tol_limit, line_dash="dash", line_color="#ff4d6d", annotation_text="Límite Tol. (+)")
        fig_trend.add_hline(y=-tol_limit, line_dash="dash", line_color="#ff4d6d", annotation_text="Límite Tol. (-)")
        fig_trend.update_layout(title="Variación del Error Angular en el Tiempo", 
