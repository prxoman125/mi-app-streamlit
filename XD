# --- SIDEBAR: CONTROLES ---
st.sidebar.title("🛠️ Configuración del Sistema")

lang = st.sidebar.selectbox("Idioma / Language", ["Español", "English"])
is_es = lang == "Español"

# Nomenclaturas dinámicas
L_H_EMISOR = "Altura del Emisor (H_emisor)" if is_es else "Emitter Height (H_emitter)"
L_DY_TARGET = "Desplazamiento Objetivo (Δy_target)" if is_es else "Target Offset (Δy_target)"
L_DIST = "Distancia de Trabajo (D)" if is_es else "Working Distance (D)"
L_TOL = "Límite de Tolerancia (mrad)" if is_es else "Tolerance Limit (mrad)"

st.sidebar.header("📊 Parámetros de Estación")
perfil = st.sidebar.selectbox("Perfil de Aplicación", ["Industrial", "Topografía", "Aeroespacial", "Investigación"])
dist_val = st.sidebar.number_input(L_DIST, 0.0, 2000.0, 100.0, help="Distancia horizontal entre el emisor y el receptor.")
h_emisor = st.sidebar.number_input(L_H_EMISOR, -100.0, 100.0, 0.0, help="Altura inicial del haz en el origen.")
dy_target = st.sidebar.number_input(L_DY_TARGET, -100.0, 100.0, 0.0, help="Desviación vertical requerida en el punto de destino.")
tol_limit = st.sidebar.slider(L_TOL, 0.0, 10.0, 1.5, help="Máximo error angular permitido antes de marcar como 'Fuera de Tolerancia'.")

st.sidebar.header("🌡️ Condiciones Ambientales")
temp = st.sidebar.number_input("Temperatura (°C)", -20.0, 50.0, 20.0)
pres = st.sidebar.number_input("Presión (hPa)", 800.0, 1100.0, 1013.25)
div_mrad = st.sidebar.number_input("Divergencia Haz (mrad)", 0.01, 5.0, 1.0)

# --- CÁLCULOS TÉCNICOS ---
# Ángulo de corrección
D_cm = dist_val * 100
angulo_rad = math.atan(dy_target / D_cm) if D_cm > 0 else 0
angulo_deg = math.degrees(angulo_rad)
mrad = angulo_rad * 1000

# Incertidumbre con SciPy
sigma_h = 0.02 # Error de precisión mecánica en cm
sigma_d = 0.5  # Error de medición de distancia en cm
incert_std = math.sqrt((sigma_h/D_cm)**2 + (dy_target*sigma_d/D_cm**2)**2) if D_cm > 0 else 0
confianza_95 = incert_std * 1000 * stats.norm.ppf(0.975)

# Tamaño del Spot
spot_size = 0.2 + (dist_val * math.tan(div_rad := div_mrad/2000)) * 200

# Estado de Tolerancia
is_safe = abs(mrad) <= tol_limit
status_text = "DENTRO DE TOLERANCIA" if is_safe else "FUERA DE TOLERANCIA"
status_color = "#1f3a1f" if is_safe else "#3a1f1f"
text_color = "#a3dda3" if is_safe else "#dda3a3"

