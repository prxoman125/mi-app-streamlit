                                     line=dict(color='#00F0FF', width=8), name="Haz Ajustado"))
        fig3d.add_trace(go.Scatter3d(x=[0, D_cm], y=[0,0], z=[0, 0], 
                                     line=dict(color='#FF0055', width=4, dash='dash'), name="Eje Cero"))
        fig3d.update_layout(paper_bgcolor='#000', plot_bgcolor='#000', scene=dict(
            xaxis=dict(gridcolor='#222'), yaxis=dict(gridcolor='#222'), zaxis=dict(gridcolor='#222')),
            height=500, margin=dict(l=0,r=0,b=0,t=0))
        st.plotly_chart(fig3d, use_container_width=True)

    with col_metrics:
        st.markdown("### 📋 Resultados de Calibración")
        st.metric("Ángulo de Corrección (α)", f"{angulo_deg:.4f}°")
        st.metric("Ajuste Angular (mrad)", f"{mrad:.3f} mrad")
        st.metric("Incertidumbre Combinada", f"±{confianza_95:.3f} mrad")
        st.metric("Diámetro del Spot (Ø)", f"{spot_size:.2f} cm")
        
        if st.button("💾 REGISTRAR EN HISTORIAL"):
            save_record({
